# Carrier branding shown across the demo
VITE_CARRIER_NAME="Maple Telecom"

# Set to "azure" to call the Azure Function proxy in front of Azure OpenAI / AI Foundry.
# Default "mock" uses scripted, streamed responses (no backend needed).
VITE_AI_MODE=mock
VITE_AI_ENDPOINT=/api/copilot

# Server-side only (Azure Function app settings – never expose to the browser)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_KEY=<from Key Vault>
